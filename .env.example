# Copy this file to .env and adjust as needed for local development.
# `docker compose -f docker/docker-compose.yml up -d` provides matching
# defaults for Postgres and Redis out of the box.

# --- Database (packages/database) ---
DATABASE_URL=postgres://kostas:kostas@localhost:5432/kostas_dev

# --- Redis (session/cache, future use) ---
REDIS_URL=redis://localhost:6379

# --- Auth (packages/auth, local provider) ---
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=dev-only-insecure-secret-change-me
SESSION_COOKIE_NAME=kostas_session

# --- Local storage provider (packages/shared StorageProvider) ---
# Resolved against the *app's* working directory (apps/web when Next runs),
# NOT the monorepo root — keep this app-relative or uploads land in a
# nested apps/web/apps/web/ directory. See apps/web/lib/storage.ts.
STORAGE_ROOT_DIR=.local-storage
STORAGE_PUBLIC_PATH_PREFIX=/api/storage

# =========================================================================
# Everything below is OPTIONAL and unset on purpose.
#
# The app is designed to run fully locally with no paid account. While a
# section is unset, that module runs in *demo mode*: clearly labelled in
# the UI, backed by seeded data, and guaranteed not to contact the real
# service. Filling a section in switches that module to the real provider
# automatically — there is no separate "demo" toggle to remember.
#
# See docs/PHASE_1_DEMO_STATUS.md for exactly what each mode does.
# =========================================================================

# --- Finance (module 10, packages/shared/src/payments) ---
# Unset: real card collection is disabled, and a clearly-labelled "Record
# demo payment" action simulates payments locally (no Stripe object is
# created; rows are tagged "[Demo payment]").
# Set: real Stripe collection takes over and the demo action refuses to run.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Emails (module 11, packages/shared/src/email) ---
# Unset: the mailbox shows "Demo Mode — Yahoo not connected". Compose,
# reply and forward all work and are saved to the local mailbox; nothing is
# ever delivered and no IMAP/SMTP connection is opened.
# Set: real Yahoo sync and sending take over.
# EMAIL_IMAP_HOST=imap.mail.yahoo.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.mail.yahoo.com
# EMAIL_SMTP_PORT=465
# EMAIL_USER=you@yahoo.com
# EMAIL_OAUTH_CLIENT_ID=
# EMAIL_OAUTH_CLIENT_SECRET=
# EMAIL_OAUTH_ACCESS_TOKEN=
# EMAIL_FROM_ADDRESS=you@yahoo.com

# --- AI Photo Search (module 12, packages/shared/src/ai-vision) ---
# Unset: upload/optimize/storage work normally and matches are ranked by a
# local colour-similarity heuristic, labelled as such. No model is called
# and no embedding is written (a fake vector would poison pgvector).
# Set: real embeddings + pgvector similarity search take over.
# OPENAI_API_KEY=sk-...

# --- Supabase (future: auth, storage, realtime) ---
# Unset: local Postgres auth, local filesystem storage, and polling-based
# realtime. All three are provider interfaces, so this is an additive swap
# rather than a rewrite. See docs/TECH_STACK.md.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Hosting / deployment (future: Vercel + custom domain) ---
# Unset: the app runs at http://localhost:3000 only. These are needed once
# the app is deployed so absolute URLs (emails, PDFs, webhooks) resolve to
# the public hostname instead of localhost.
# NEXT_PUBLIC_APP_URL=https://kostasupholstery.example.com
# VERCEL_PROJECT_ID=
# VERCEL_ORG_ID=
