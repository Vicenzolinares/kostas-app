# Copy this file to .env and adjust as needed for local development.
# `docker compose -f docker/docker-compose.yml up -d` provides matching
# defaults for Postgres and Redis out of the box.

# --- Database (packages/database) ---
DATABASE_URL=postgres://kostas:kostas@localhost:5432/kostas_dev

# --- Redis (session/cache, future use) ---
REDIS_URL=redis://localhost:6379

# --- Auth (packages/auth, local provider) ---
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=dev-only-insecure-secret-change-me
SESSION_COOKIE_NAME=kostas_session

# --- Local storage provider (packages/shared StorageProvider) ---
STORAGE_ROOT_DIR=./apps/web/.local-storage
STORAGE_PUBLIC_PATH_PREFIX=/api/storage

# --- Future Supabase swap (not used yet, see docs/TECH_STACK.md) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
