# Copy this file to .env and adjust as needed for local development.
# `docker compose -f docker/docker-compose.yml up -d` provides matching
# defaults for Postgres and Redis out of the box.

# --- Database (packages/database) ---
DATABASE_URL=postgres://kostas:kostas@localhost:5432/kostas_dev

# --- Redis (session/cache, future use) ---
REDIS_URL=redis://localhost:6379

# --- Auth (packages/auth, local provider) ---
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=dev-only-insecure-secret-change-me
SESSION_COOKIE_NAME=kostas_session

# --- Local storage provider (packages/shared StorageProvider) ---
STORAGE_ROOT_DIR=./apps/web/.local-storage
STORAGE_PUBLIC_PATH_PREFIX=/api/storage

# --- Future Supabase swap (not used yet, see docs/TECH_STACK.md) ---
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Finance (module 10, packages/shared/src/payments) ---
# No live Stripe account exists yet. Leave unset for local dev — the app
# degrades gracefully (payment buttons disabled, clear error instead of a
# crash). See docs/PROGRESS.md for what's needed to go live.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Emails (module 11, packages/shared/src/email) ---
# No live Yahoo OAuth app exists yet. Leave unset for local dev — sync
# and send are inert with a clear "not configured" error. See
# docs/PROGRESS.md for what's needed to go live.
# EMAIL_IMAP_HOST=imap.mail.yahoo.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.mail.yahoo.com
# EMAIL_SMTP_PORT=465
# EMAIL_USER=you@yahoo.com
# EMAIL_OAUTH_CLIENT_ID=
# EMAIL_OAUTH_CLIENT_SECRET=
# EMAIL_OAUTH_ACCESS_TOKEN=
# EMAIL_FROM_ADDRESS=you@yahoo.com

# --- AI Photo Search (module 12, packages/shared/src/ai-vision) ---
# No live OpenAI key exists yet. Leave unset for local dev — uploads are
# accepted but matching returns a clear "not configured" error. See
# docs/PROGRESS.md for what's needed to go live.
# OPENAI_API_KEY=sk-...
